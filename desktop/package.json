{
  "name": "kotsu-desktop",
  "productName": "Kotsu",
  "version": "1.3.0",
  "description": "Kotsu — daily planner & goals",
  "author": "Rounit002",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.rounit002.kotsu",
    "files": ["main.js", "preload.cjs", { "from": "../dist", "to": "dist" }],
    "directories": { "output": "release" },
    "artifactName": "Kotsu-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    }
  }
}
